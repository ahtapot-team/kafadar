{
  "deck_id": "cift",
  "version": 1,
  "lang": "tr",
  "cards": [
    {
      "id": "cift-01",
      "text": "Sevgilinin her gün eski sevgilisiyle mesajlaşması."
    },
    {
      "id": "cift-02",
      "text": "Sevgilinin telefonunu karıştırmak."
    },
    {
      "id": "cift-03",
      "text": "İlişkide sürekli konum paylaşmak."
    },
    {
      "id": "cift-04",
      "text": "Eski sevgilinin fotoğraflarını telefonda saklamak."
    },
    {
      "id": "cift-05",
      "text": "Sevgilinin Instagram şifresini bilmek istemek."
    },
    {
      "id": "cift-06",
      "text": "Sevgilinin karşı cinsten en yakın arkadaşı olması."
    },
    {
      "id": "cift-07",
      "text": "İlk buluşmada hesabı bölüşmek."
    },
    {
      "id": "cift-08",
      "text": "Sevgilinle bilerek aynı kıyafeti giymek."
    },
    {
      "id": "cift-09",
      "text": "Yıldönümünü unutmak."
    },
    {
      "id": "cift-10",
      "text": "Kavgadan sonra özür dilemeden \"acıktın mı?\" diye barışmak."
    },
    {
      "id": "cift-11",
      "text": "Sevgilinin arkadaşlarıyla sensiz tatile gitmesi."
    },
    {
      "id": "cift-12",
      "text": "Sevgilinin tabağından sormadan patates almak."
    },
    {
      "id": "cift-13",
      "text": "İlişkini sosyal medyada hiç paylaşmamak."
    },
    {
      "id": "cift-14",
      "text": "Sevgilinin fotoğrafını profil fotoğrafı yapmak."
    },
    {
      "id": "cift-15",
      "text": "Her gece görüntülü konuşurken uyuyakalmak."
    },
    {
      "id": "cift-16",
      "text": "Sevgilinin annesine \"anne\" demek."
    },
    {
      "id": "cift-17",
      "text": "Sevgiline \"kilo mu aldın?\" diye sormak."
    },
    {
      "id": "cift-18",
      "text": "Bir ünlüyü beğendiğini sevgiline söylemek."
    },
    {
      "id": "cift-19",
      "text": "Tartışırken eski konuları açmak."
    },
    {
      "id": "cift-20",
      "text": "Sevgilinin mesajına 3 saat sonra cevap vermek."
    },
    {
      "id": "cift-21",
      "text": "Birlikte izlediğiniz diziyi gizlice önden izlemek."
    },
    {
      "id": "cift-22",
      "text": "Sevgiline doğum gününde para hediye etmek."
    },
    {
      "id": "cift-23",
      "text": "Sevgilinin eski sevgilisinin de geleceği düğüne gitmek."
    },
    {
      "id": "cift-24",
      "text": "İlk \"seni seviyorum\"u mesajla söylemek."
    },
    {
      "id": "cift-25",
      "text": "Sevgilinin başkasının fotoğrafını beğenmesi."
    },
    {
      "id": "cift-26",
      "text": "Sevgilini bilerek kıskandırmak."
    },
    {
      "id": "cift-27",
      "text": "Her tartışmada son sözü söylemek istemek."
    },
    {
      "id": "cift-28",
      "text": "Ayrıldıktan sonra arkadaş kalmak."
    },
    {
      "id": "cift-29",
      "text": "Ayrılıp tekrar barışmak."
    },
    {
      "id": "cift-30",
      "text": "Sevgilinin ailesiyle ilk tanışmaya geç kalmak."
    },
    {
      "id": "cift-31",
      "text": "İlişkinin üçüncü ayında birlikte yaşamaya başlamak."
    },
    {
      "id": "cift-32",
      "text": "Ayrılığı mesajla söylemek."
    },
    {
      "id": "cift-33",
      "text": "Sevgilinin arkadaş grubunu sevmediğini ona söylemek."
    },
    {
      "id": "cift-34",
      "text": "Sevgilinin, senin arkadaşlarınla senden daha yakın olması."
    },
    {
      "id": "cift-35",
      "text": "Sevgilinden gizli alışveriş yapmak."
    },
    {
      "id": "cift-36",
      "text": "Sevgilinin ilişkinizle ilgili her şeyi annesine anlatması."
    },
    {
      "id": "cift-37",
      "text": "Sürpriz hazırlamak için sevgiline yalan söylemek."
    },
    {
      "id": "cift-38",
      "text": "Ortak birikimden kendine pahalı bir şey almak."
    },
    {
      "id": "cift-39",
      "text": "\"Bugün hiçbir şey yapmak istemiyorum\" deyip arkadaşlarla çıkmak."
    },
    {
      "id": "cift-40",
      "text": "Horlama yüzünden tatilde ayrı odalarda kalmak."
    },
    {
      "id": "cift-41",
      "text": "Sevgilinin seni etiketlemeden ortak fotoğraf paylaşması."
    },
    {
      "id": "cift-42",
      "text": "Eski sevgiliden kalan hediyeyi kullanmaya devam etmek."
    },
    {
      "id": "cift-43",
      "text": "İlk buluşmada sürekli telefona bakmak."
    },
    {
      "id": "cift-44",
      "text": "Telefon şifreni sevgiline vermek."
    },
    {
      "id": "cift-45",
      "text": "Sevgilinin bir gün tek başına kalmak istemesi."
    },
    {
      "id": "cift-46",
      "text": "Sevgilinle aynı iş yerinde çalışmak."
    },
    {
      "id": "cift-47",
      "text": "Sevgilinin hobisini seviyormuş gibi yapmak."
    },
    {
      "id": "cift-48",
      "text": "Sevgilinin eski mesajlarını okuyup kıskanmak."
    },
    {
      "id": "cift-49",
      "text": "Sevgilinin seni arkadaşlarına şikâyet etmesi."
    },
    {
      "id": "cift-50",
      "text": "Yıldönümünde hediye yerine \"birlikte olmamız yeter\" demek."
    },
    {
      "id": "cift-51",
      "text": "Sevgilinin seni rehberde komik bir isimle kaydetmesi."
    },
    {
      "id": "cift-52",
      "text": "Sevgiline her sabah \"günaydın\" mesajı atmamak."
    },
    {
      "id": "cift-53",
      "text": "Sevgilinin, yaptığın yemeği beğenmediğini dürüstçe söylemesi."
    },
    {
      "id": "cift-54",
      "text": "Oyun oynarken sevgilinin mesajını görmezden gelmek."
    },
    {
      "id": "cift-55",
      "text": "Sevgilinin doğum gününü takvim hatırlatmasıyla hatırlamak."
    }
  ]
}
